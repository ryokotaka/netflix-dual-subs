{
  "manifest_version": 3,
  "name": "Netflix Dual Subs (personal)",
  "version": "0.1.0",
  "description": "英語＋日本語の二重字幕、字幕一覧、熟語対応のホバー辞書。自分用。",
  "permissions": ["storage"],
  "host_permissions": ["https://www.netflix.com/*", "https://*.nflxvideo.net/*", "https://*.nflxso.net/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["lib.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["dict.json"], "matches": ["https://www.netflix.com/*"] }
  ]
}
